{
  "tasks": {
    "run": "deno run -A main.ts",
    "dev": "deno fmt && deno lint",
    "test": "deno test --allow-env --allow-read utils_test.ts instapaper_test.ts textToSpeech_test.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/testing": "jsr:@std/testing@^1.0.18",
    "gcp-metadata": "npm:gcp-metadata@8.1.2",
    "tts": "npm:@google-cloud/text-to-speech@6.4.0"
  },
  "fmt": {
    "semiColons": false,
    "useTabs": false,
    "lineWidth": 160
  },
  "nodeModulesDir": "auto"
}
